<UIRequestInterceptorConfiguration>
    <BackChannelLogout>
        {% if ui_request_interceptor is defined and ui_request_interceptor.backchannel_logout is defined %}
        <Enabled>{{ui_request_interceptor.backchannel_logout.enabled}}</Enabled>
        <Issuer>{{ui_request_interceptor.backchannel_logout.issuer}}</Issuer>
        <JwksUri>{{ui_request_interceptor.backchannel_logout.jwks_uri}}</JwksUri>
        <AllowedClockSkewSeconds>{{ui_request_interceptor.backchannel_logout.allowed_clock_skew_seconds}}</AllowedClockSkewSeconds>
        <StaleMappingRetentionSeconds>{{ui_request_interceptor.backchannel_logout.stale_mapping_retention_seconds}}</StaleMappingRetentionSeconds>
        {% else %}
        <Enabled>true</Enabled>
        <Issuer>https://localhost:9443/oauth2/token</Issuer>
        <JwksUri>https://localhost:9443/oauth2/jwks</JwksUri>
        <AllowedClockSkewSeconds>60</AllowedClockSkewSeconds>
        <StaleMappingRetentionSeconds>86400</StaleMappingRetentionSeconds>
        {% endif %}
    </BackChannelLogout>
</UIRequestInterceptorConfiguration>
